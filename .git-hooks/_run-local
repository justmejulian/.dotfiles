#!/bin/sh
#
# Setting core.hooksPath globally disables each repo's .git/hooks.
# Hooks in this folder call this at the end so repo-local hooks still run.

hook_name=$1; shift
local_hook="$(git rev-parse --git-common-dir)/hooks/$hook_name"

if [ -x "$local_hook" ]; then
    exec "$local_hook" "$@"
fi
exit 0
