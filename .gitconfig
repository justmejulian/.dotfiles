[user]
	name = Julian
	email = julian@foxglove.dev
[diff]
  external = difft
[init]
  defaultBranch = main
[core]
   editor = nvim
	excludesfile = ~/.gitignore_global
	hooksPath = /Users/julianvisser/.git-hooks
[commit]
   verbose = true
[push]
   autoSetupRemote = true
[alias]
   stash = stash --all
[rerere]
   enabled = true

[includeIf "gitdir:~/Documents/git/private/"]
   path = ~/Documents/git/private/.gitconfig

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
