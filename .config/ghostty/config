font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# to allow äöü
macos-option-as-alt = false

window-title-font-family = "JetBrainsMono Nerd Font Mono"

theme = Catppuccin Mocha

window-new-tab-position = end
macos-titlebar-style = tabs

window-padding-x = 8
window-padding-y = 8

keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

keybind = global:cmd+ctrl+alt+q=toggle_quick_terminal
