font-size = 12
maximize = true

# Embed Catppuccin Mocha: Appify doesn't bundle Ghostty's named theme files.
# Keep these colors in sync with Ghostty's Catppuccin Mocha theme.
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
cursor-text = #1e1e2e
selection-background = #f5e0dc
selection-foreground = #1e1e2e
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f7aec2
palette = 10=#c2ecbf
palette = 11=#fcd682
palette = 12=#aeccfc
palette = 13=#f398da
palette = 14=#b1eae1
palette = 15=#a6adc8
font-family = "JetBrainsMono Nerd Font Mono"

# Herdr.app: release these cmd chords so they reach herdr, which binds them in
# ~/.config/herdr/config.toml.
keybind = cmd+t=unbind
keybind = cmd+n=unbind
keybind = cmd+shift+n=unbind
keybind = cmd+w=unbind
keybind = cmd+k=unbind
keybind = cmd+b=unbind
keybind = cmd+shift+w=unbind
keybind = cmd+r=unbind
keybind = cmd+shift+r=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+shift+enter=unbind
keybind = cmd+[=unbind
keybind = cmd+]=unbind
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind
keybind = cmd+bracket_left=unbind
keybind = cmd+bracket_right=unbind
keybind = cmd+shift+bracket_left=unbind
keybind = cmd+shift+bracket_right=unbind
keybind = cmd+e=unbind
keybind = cmd+p=unbind
keybind = cmd+alt+left=unbind
keybind = cmd+alt+right=unbind
keybind = cmd+alt+up=unbind
keybind = cmd+alt+down=unbind
keybind = cmd+alt+h=unbind
keybind = cmd+alt+j=unbind
keybind = cmd+alt+k=unbind
keybind = cmd+alt+l=unbind
keybind = cmd+1=unbind
keybind = cmd+2=unbind
keybind = cmd+3=unbind
keybind = cmd+4=unbind
keybind = cmd+5=unbind
keybind = cmd+6=unbind
keybind = cmd+7=unbind
keybind = cmd+8=unbind
keybind = cmd+9=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+digit_9=unbind

# Release Ghostty's tab-switching chords so herdr gets them (next/previous
# workspace). herdr enables the Kitty keyboard protocol, so Ghostty encodes
# them itself, like the cmd chords above.
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = cmd+o=unbind
keybind = cmd+semicolon=unbind

# ctrl+1..9 switch herdr workspaces (switch_workspace in app.toml).
keybind = ctrl+1=unbind
keybind = ctrl+2=unbind
keybind = ctrl+3=unbind
keybind = ctrl+4=unbind
keybind = ctrl+5=unbind
keybind = ctrl+6=unbind
keybind = ctrl+7=unbind
keybind = ctrl+8=unbind
keybind = ctrl+9=unbind
keybind = ctrl+digit_1=unbind
keybind = ctrl+digit_2=unbind
keybind = ctrl+digit_3=unbind
keybind = ctrl+digit_4=unbind
keybind = ctrl+digit_5=unbind
keybind = ctrl+digit_6=unbind
keybind = ctrl+digit_7=unbind
keybind = ctrl+digit_8=unbind
keybind = ctrl+digit_9=unbind
