#!/usr/bin/env bash
# Summarise model calls recorded by the develop/address-feedback workflows.
#
#   run-stats              all runs, per role
#   run-stats <repo>       runs for one repo (e.g. app)
#   run-stats <run-dir>    one run
set -euo pipefail

root="$HOME/.pi/agent/workflows/runs"
target=${1:-}
if [ -n "$target" ] && [ -d "$target" ]; then
  files=$(find "$target" -name stats.jsonl)
else
  files=$(find "$root/${target}" -name stats.jsonl 2>/dev/null || true)
fi
[ -n "$files" ] || { echo "no stats found"; exit 0; }

runs=$(wc -l <<<"$files" | tr -d ' ')
cat $files | jq -rs --arg runs "$runs" '
  "runs: \($runs)   calls: \(length)   total: $\(map(.costUsd) | add * 100 | round / 100)\n"'
cat $files | jq -rs '
  def r2: . * 100 | round / 100;
  (["role", "model", "calls", "cost", "avg cost", "avg min", "failed", "warnings"] | @tsv),
  (group_by(.role)[] | [
    .[0].role,
    "\(.[0].model) \(.[0].effort // "")",
    length,
    "$\(map(.costUsd) | add | r2)",
    "$\(map(.costUsd) | add / length | r2)",
    (map(.durationMs) | add / length / 60000 | r2),
    (map(select(.outcome != "ok")) | length),
    (map(.warnings | length) | add)
  ] | @tsv)' | column -t -s $'\t'
