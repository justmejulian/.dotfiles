{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@osolmaz/pi-workflows": [
        "../npm/node_modules/@osolmaz/pi-workflows/dist/workflows/index.d.ts"
      ]
    }
  },
  "include": ["*.workflow.ts", "lib/*.ts", "tests/*.ts"]
}
